# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML artifacts (regenerated by training)
backend/artifacts/*.joblib
backend/artifacts/*.pkl
# Gerçek veri setleri (Faz 6): lisansları yeniden dağıtıma izin vermeyebilir,
# bu yüzden repoya HİÇBİRİ girmez. Sadece açıklama dosyası izlenir.
backend/data/*
!backend/data/README.md
*.db
*.sqlite3

# .NET (Faz 7) — derleme çıktıları, Python'daki __pycache__ gibi
maintenance/**/bin/
maintenance/**/obj/
maintenance/**/*.db
maintenance/**/*.db-shm
maintenance/**/*.db-wal
*.user

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Env & editors
.env
.env.local
.DS_Store
.idea/
.vscode/
*.log

# Keep placeholders
!backend/artifacts/.gitkeep

# Marka varlıkları depoya girmez (bkz. frontend/public/brand/README.md)
frontend/public/brand/*
!frontend/public/brand/README.md

# Yerel geliştirme TLS sertifikaları
certs/

# Mimari diyagram üretiminde Edge geçici profili
docs/architecture/src/edge-profile/

