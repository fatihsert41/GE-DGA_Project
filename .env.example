# TransformerAI — ortam değişkenleri örneği
#
# Bu dosyayı `.env` adıyla kopyalayıp doldurun. `.env` git'e GİRMEZ
# (.gitignore); bu örnek dosya ise girer, çünkü içinde sır yok.
#
# Yerel geliştirmede (start.ps1) hiçbirine gerek yoktur: servisler
# geliştirme ortamında açılır ve kaynak koddaki geliştirme anahtarını kullanır.
# Üretim ya da Docker kurulumunda bu değişkenler ZORUNLUDUR — eksikse
# servisler açılmayı reddeder.

# --- Belirteç imza anahtarı -----------------------------------------------
# .NET ve Python AYNI değeri kullanmalı; farklıysa her giriş Python'da 401 alır.
# En az 32 karakter. Kriptografik rastgele üretin, elle yazmayın:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# (PowerShell'in Get-Random'ı kriptografik değildir, bu iş için kullanmayın.)
TRANSFORMERAI_AUTH_SECRET=

# --- Ortam ----------------------------------------------------------------
# development dışındaki her değerde: anahtar zorunlu, geliştirme anahtarı ve
# 32 karakterden kısa anahtar reddedilir.
TRANSFORMERAI_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# --- Python API'sine tarayıcıdan erişebilecek kökenler (virgülle) -----------
TRANSFORMERAI_CORS_ORIGINS=https://localhost:5173,http://localhost:5173
